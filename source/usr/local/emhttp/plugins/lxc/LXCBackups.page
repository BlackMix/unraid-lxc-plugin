<?php
require_once('/usr/local/emhttp/plugins/lxc/include/Container.php');
require_once('/usr/local/emhttp/plugins/lxc/include/ProxmoxBackup.php');
if (!isset($allContainers) || !is_array($allContainers)) {
  $allContainers = getAllContainers();
}
$backupSettings = new Settings();
$defaultVmid = (int) ($backupSettings->proxmox_vmid ?: 100);
?>

<link rel="stylesheet" href="/plugins/lxc/css/lxc.css">
<?php require '/usr/local/emhttp/plugins/lxc/include/csrf.php' ?>
<script src="/plugins/lxc/js/lxc.js"></script>

<?php foreach ($allContainers as $container) { ?>
        <h2 id="<?= $container->name ?>"><?= $container->name ?></h2>
        <br>

        <? if ($backupSettings->backup_enabled === 'enabled') { ?>
        <h3>LXC backups</h3>
        <table id="snapshot_table" class="tablesorter two shift">
            <thead>
            <tr>
                <th style='width: 300px;'>Name</th>
                <th style='width: 400px; min-width: 150px; max-width: 150px;'>Date/Time</th>
                <th style='min-width: 500px;'>Actions</th>
            </tr>
            </thead>
            <tbody align="left">
<?
        if (count($container->backups) > 0) {
          foreach ($container->backups as $backup) {
            ?>
            <tr style='height: 50px;'>
              <td><?= $backup->name?></td>
              <td><?= $backup->date ?> <?= $backup->time ?></td>
              <td>
                <a href='/LXCRestoreBackup?cont=<?= $container->name?>&backup=<?= $backup->time ?>_<?= $backup->date ?>.tar.xz' class='button'>Create Container From Backup</a>
                <a href="#" class="button deleteBACKUP" id="<?= $container->name ?> <?= $backup->name ?>_<?= $backup->time ?>_<?= $backup->date ?>">Delete Backup</a>
              </td>
            </tr>
<?php
          }
        } else {
          echo "<tr style='height: 50px;'><td>No Backups</td><td>&nbsp;</td><td>&nbsp;</td><tr>";
        }
        echo "</tbody></table>";
        }
        ?>

        <h3>Proxmox-compatible backups <small>(experimental)</small></h3>
        <p style="font-size:9pt;opacity:.8;">
          The container is stopped during the backup and restarted afterwards. Restore with
          <code>pct restore &lt;vmid&gt; &lt;file&gt; --rootfs &lt;storage&gt;:&lt;size&gt;</code>.
          The config uses a placeholder rootfs; override it at restore time. Validate with a real Proxmox before relying on it.
        </p>
        <div class="lxcv2-proxmox-create">
          <label>VMID: <input type="number" min="100" max="999999999" id="px_vmid_<?= $container->name ?>" value="<?= $defaultVmid ?>" style="width:120px"></label>
          <input type="button" class="button createProxmoxBackup" value="Create Proxmox Backup" data-container="<?= $container->name ?>">
        </div>
        <table class="tablesorter two shift" style="margin-top:8px;">
          <thead><tr><th>File</th><th>VMID</th><th>Date</th><th>Size</th><th>Actions</th></tr></thead>
          <tbody align="left">
<?
        $pxBackups = ProxmoxBackup::list($container->name);
        if ($pxBackups === []) {
            echo "<tr><td colspan='5'>No Proxmox backups</td></tr>";
        } else {
            foreach ($pxBackups as $entry) {
                echo '<tr style="height:40px;">'
                    . '<td>' . $entry['file'] . '</td>'
                    . '<td>' . $entry['vmid'] . '</td>'
                    . '<td>' . str_replace('_', ' ', $entry['stamp']) . '</td>'
                    . '<td>' . round($entry['size'] / 1048576) . ' MiB</td>'
                    . '<td>'
                    . '<a href="#" class="button downloadProxmoxBackup" data-container="' . $container->name . '" data-file="' . $entry['file'] . '">Download</a> '
                    . '<a href="#" class="button deleteProxmoxBackup" data-container="' . $container->name . '" data-file="' . $entry['file'] . '">Delete</a>'
                    . '</td></tr>';
            }
        }
?>
          </tbody>
        </table>
<?php } ?>
