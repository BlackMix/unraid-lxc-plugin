# Copie para .env e preencha com um Personal Access Token do GitHub.
# O token precisa da permissão "repo" (ou "contents: write" para fine-grained tokens).

GITHUB_TOKEN=SEU_TOKEN_AQUI

# Dono do repositório (usado apenas como fallback de validação; o push usa
# x-access-token como usuário, que é o padrão para PAT).
GITHUB_USER=BlackMix
